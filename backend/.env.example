PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/expirEase_db?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
